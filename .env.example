# Copia este archivo como .env y coloca tus credenciales locales
# OJO: subir la SECRET_KEY real a un repositorio es una mala práctica.
# Ponla solo en tu .env (que está en .gitignore), nunca en este archivo.
SECRET_KEY=cambia-esta-clave-por-una-larga-y-secreta
DEBUG=True

DB_NAME=clase_orm_db
# Usuario de MySQL (normalmente es root)
DB_USER=root
# Tu contraseña de MySQL
DB_PASSWORD=PonTuContraseña
DB_HOST=localhost
DB_PORT=3306
